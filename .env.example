# Flask (reserved for future session-based features)
FLASK_SECRET_KEY=replace-with-a-long-random-value

# Public Supabase browser configuration (safe to expose to signed-in clients).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only key for invitations. Set as a Cloudflare Worker secret, never in Git.
SUPABASE_SECRET_KEY=
